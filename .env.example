# Copy to .env and fill in. Never commit .env.
# Only needed for the planned PostgreSQL port (docker compose --profile postgres-port). Not used by the code yet.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Fernet key that encrypts stored exchange credentials (server side only).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Versioned keys: "1:<key>" now; to rotate add ",2:<newkey>" (newest version encrypts), then run re-encryption. Old keys stay until done.
ENCRYPTION_KEYS=
# One-time secret that allows POST /auth/bootstrap to create the FIRST admin. Unset it after bootstrap.
DEWAKO_BOOTSTRAP_TOKEN=
# SQLite file holding orders, positions, safety state, risk state, users, audit. Back it up.
DEWAKO_TRADING_DB=dewako_trading.db
DEWAKO_RATE_LIMIT=120
# Code plugins run arbitrary Python with server privileges. Keep 0 unless you control the machine.
DEWAKO_ALLOW_CODE_PLUGINS=0
DEWAKO_PLUGIN_DIR=plugins/strategies
# SQLite file for the point-in-time market data store
DEWAKO_DB_PATH=dewako_market.db
DEWAKO_STRATEGY_LOCK=strategy_versions.lock.json
AI_API_KEY=
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
COINMETRICS_API_KEY=
KAIKO_API_KEY=
TRADING_ECONOMICS_API_KEY=
NEWS_API_KEY=

# --- Phase 3.3 -------------------------------------------------------------------------------------------------
# development (default) may use a SQLite path. production REQUIRES a PostgreSQL URL below and never falls back to SQLite.
DEWAKO_ENV=development
# DEWAKO_DATABASE_URL=postgresql://dewako:CHANGE_ME@postgres:5432/dewako
# Browser origins allowed to call the API (comma separated, https/http only, no wildcard). Empty = same-origin only.
DEWAKO_CORS_ORIGINS=

# Stage 1.1 (both optional; unset = feature off; invalid values refuse to start)
# DEWAKO_MAX_HOLD_SECONDS=            # time stop: close a position held longer than this many seconds. Unset = NO time stop.
# DEWAKO_EMERGENCY_EXIT_MAX_SPREAD_PCT=   # spread tolerance (<=100 %) for a TRIGGERED TAKE-PROFIT or time stop. Unset = such an exit waits for a normal spread (CRITICAL incident). A STOP-LOSS is never deferred for spread and ignores this setting.
# Stage 2 exit policy (a STOP-LOSS exits at once; these two only guard against a bad quote):
# DEWAKO_STOP_SUSPECT_SPREAD_PCT=10        # a stop that sees a spread above this % is held until the quote persists. Default 10; 'off' removes the safeguard.
# DEWAKO_STOP_SUSPECT_CONFIRM_CYCLES=3     # consecutive monitor cycles a suspect quote must persist before the stop is sent. Default 3; 1 = no wait.
